<?xml version="1.0"?>
<package format="2">
  <name>omni_robot_ros</name>
  <version>0.1.0</version>
  <description>ROS Melodic joystick teleoperation and can-utils velocity bridge for the ltika STM32 board.</description>
  <maintainer email="maintainer@example.com">Omni robot project maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>can-utils</exec_depend>
  <export/>
</package>
